<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and below. Kickset promises that jobs, cuts and settings stay on the phone, so nothing
  is eligible for Auto Backup. The manual "Back up to file" export is the only way data leaves.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
